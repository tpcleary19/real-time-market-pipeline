# Set these in the repository root .env or export them in your shell.
DATABASE_URL=postgres://market:market@localhost:5432/market_data
KAFKA_BROKERS=localhost:9092
SPIKE_OUTPUT_TOPIC=price-spikes
INVESTIGATOR_CONSUMER_GROUP=market-investigator
# Only for integration tests, pointing to a separate test database:
# TEST_DATABASE_URL=postgres://market:market@localhost:5432/market_data_test

# Manual investigation (paid model and web search requests):
# Use anthropic for Claude, or openai for OpenAI.
INVESTIGATOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# CLAUDEKEY is also accepted as an alias for ANTHROPIC_API_KEY.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only needed when INVESTIGATOR_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Asset identity lookup uses the same credentials as market-producer:
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Use https://api.alpaca.markets for live-account keys instead.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
